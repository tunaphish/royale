{
  "name": "royale",
  "version": "0.0.1",
  "description": "a game about everything",
  "author": "Tuan Pham",
  "homepage": "http://tunaphish.github.io/royale",
  "private": "true",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/authoring-tables.mjs --check && tsc --noEmit && eslint . && vitest run && vite build",
    "docs": "node scripts/authoring-tables.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.6",
    "inkjs": "^2.4.0",
    "mobx": "^6.13.2",
    "mobx-react-lite": "^4.0.7",
    "phaser": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^2.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "typescript-plugin-css-modules": "^5.1.0",
    "typescript-tslint-plugin": "^0.5.5",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
