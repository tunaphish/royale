{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "strict": true,
    "strictPropertyInitialization": false,
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["src", "vite.config.ts"]
}
